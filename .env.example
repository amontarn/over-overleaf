# Public identity and URLs
OVERLEAF_APP_NAME=Over-Overleaf
OVERLEAF_SITE_URL=https://latex.example.org
OVERLEAF_GIT_BRIDGE_PUBLIC_URL=https://git.latex.example.org

# Listen on loopback, behind a TLS reverse proxy
OVERLEAF_HTTP_PORT=127.0.0.1:8080
OVERLEAF_GIT_PORT=127.0.0.1:8000

# Generate FOUR DIFFERENT values with: openssl rand -base64 48
# Never reuse the same value across these secrets. Startup is refused if any
# is empty or left on an example value.
OVERLEAF_EXTENSIONS_SECRET=replace-with-a-random-production-secret
OVERLEAF_INVITE_TOKEN_SECRET=replace-with-another-random-production-secret
OVERLEAF_SESSION_SECRET=replace-with-a-third-random-production-secret
# Distinct internal secret for web <-> git-bridge calls.
OVERLEAF_GIT_BRIDGE_INTERNAL_SECRET=replace-with-a-fourth-random-production-secret

# In production over HTTPS: enables the Secure attribute on the session cookie.
# Leave empty for plain-HTTP local development.
OVERLEAF_SECURE_COOKIE=true

# Git and GitLab features
OVERLEAF_GIT_BRIDGE_ENABLED=true
OVERLEAF_GITLAB_CONNECTOR_AVAILABLE=true
OVERLEAF_GITLAB_ALLOW_PRIVATE_HOSTS=false

# In production, only allow HTTP or private networks if the AI provider is a
# trusted internal service and that choice has been evaluated explicitly.
OVERLEAF_AI_ALLOW_PRIVATE_HOSTS=false
OVERLEAF_AI_ALLOW_INSECURE_HTTP=false
